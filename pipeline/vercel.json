{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cron.py": {
      "maxDuration": 300,
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/cron/:phase",
      "destination": "/api/cron?phase=:phase"
    }
  ],
  "schedules": {
    "backfill": {
      "schedule": "40 * * * *",
      "path": "/api/cron/backfill",
      "requestMethod": "GET"
    },
    "discover": {
      "schedule": "0 * * * *",
      "path": "/api/cron/discover",
      "requestMethod": "GET"
    },
    "transcripts": {
      "schedule": "10 * * * *",
      "path": "/api/cron/transcripts",
      "requestMethod": "GET"
    },
    "insights": {
      "schedule": "20 * * * *",
      "path": "/api/cron/insights",
      "requestMethod": "GET"
    },
    "watchlist-alerts": {
      "schedule": "0 2 * * *",
      "path": "/api/cron/watchlist-alerts",
      "requestMethod": "GET"
    },
    "weekly-digest": {
      "schedule": "0 2 * * 1",
      "path": "/api/cron/weekly-digest",
      "requestMethod": "GET"
    },
    "catalog-sync": {
      "schedule": "0 21 * * *",
      "path": "/api/cron/catalog-sync",
      "requestMethod": "GET"
    }
  }
}
