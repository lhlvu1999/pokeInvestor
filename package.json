{
  "name": "poke-investor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && cd pipeline && uv run pytest -q && uv run ruff check src tests",
    "smoke": "tsx scripts/smoke.ts",
    "check:schema": "tsx --env-file=.env scripts/check-schema.ts",
    "check:vision": "tsx --env-file=.env scripts/check-vision.ts",
    "check:vision:selftest": "tsx scripts/check-vision.ts --selftest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run db:migrate",
    "db:reset:demo": "npm run db:reset && npm run db:seed",
    "setup:env": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')){fs.copyFileSync('.env.example','.env');console.log('Created .env from .env.example')}else{console.log('.env already exists, skipping')}\"",
    "setup": "npm run setup:env && docker compose up -d --wait && npm run db:migrate",
    "setup:fresh": "npm run setup && npm run db:seed",
    "kickstart": "npm install && npm run setup && npm run dev"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "next": "16.4.6",
    "openai": "^7.4.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@8.15.4+sha512.0bd3a9be9eb0e9a692676deec00a303ba218ba279d99241475616b398dbaeedd11146f92c2843458f557b1d127e09d4c171e105bdcd6b61002b39685a8016b9e"
}
