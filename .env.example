DATABASE_URL=postgres://poke:poke@localhost:5432/poke_investor

# Required only for the Python pipeline's `insights` phase. The Next.js app
# does not read this — leave blank if you only run discover/transcripts.
OPENAI_API_KEY=

# Point at a local OpenAI-compatible server (Ollama, LM Studio, llama.cpp).
# Leave unset to use api.openai.com. When set to a non-OpenAI URL, the
# pipeline auto-switches to `json_object` mode since strict structured
# outputs are an OpenAI-only feature. See pipeline/README.md for a
# step-by-step Ollama setup.
# OPENAI_BASE_URL=http://localhost:11434/v1
# PIPE_LLM_JSON_MODE=1   # force JSON mode regardless of base URL

# Per-environment LLM overrides — take precedence over whatever the active
# row in the `prompts` table has. Lets you keep the same prompt across dev
# and prod and just flip the model/temperature via env.
#   LLM_MODEL=qwen2.5:7b      # any non-empty value → overrides prompt.model
#   LLM_TEMPERATURE=0.1       # numeric → overrides prompt.temperature
#   LLM_TEMPERATURE=null      # literal "null" → omit temperature entirely
#                             # (needed for OpenAI o-series models)
#   LLM_TIMEOUT_SEC=1800      # per-request timeout. Default 1800 (30 min).
#                             # Local models on CPU can need this; the
#                             # OpenAI SDK's 600s default trips on long
#                             # transcripts through qwen2.5:14b.
# LLM_MODEL=
# LLM_TEMPERATURE=
# LLM_TIMEOUT_SEC=

# Token budget for the LLM call. The pipeline clips transcripts so the
# rendered prompt + reserved output fit within LLM_CONTEXT_TOKENS — this
# avoids the runner-side prompt truncation that breaks structured outputs
# (notably Ollama's `keep=4` truncation which drops the system prompt).
#
# Set LLM_CONTEXT_TOKENS to the *actual* context window of your server.
# For Ollama, that's the value of OLLAMA_CONTEXT_LENGTH you started it
# with (default 32768 for qwen2.5). For api.openai.com, use the model's
# native context.
#
# When a transcript doesn't fit, it's head+tail clipped: HEAD_RATIO of the
# budget from the *start* of the video, the remainder from the *end*. The
# middle is dropped with a `[... transcript clipped ...]` marker so the
# model knows. Pokémon investment videos usually front-load product picks
# and end with summaries, so 0.6 (60% head / 40% tail) preserves both.
#
# LLM_MIN_TRANSCRIPT_TOKENS is the floor — if context minus overhead minus
# output leaves less than this for the transcript, the video is skipped as
# errored rather than producing a near-empty prompt.
# LLM_CONTEXT_TOKENS=32768
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_TRANSCRIPT_HEAD_RATIO=0.6
# LLM_MIN_TRANSCRIPT_TOKENS=500

# Optional pipeline tunables (see pipeline/README.md for full list).
# PIPE_DISCOVER_MAX=50
# PIPE_INSIGHTS_BATCH=25
# PIPE_HTTP_TIMEOUT_SEC=30

# Which engine fetches transcripts:
#   - youtube_captions (default): scrape YouTube's timedtext endpoint. Fast,
#     free, brittle when YouTube IP-blocks you.
#   - whisper: download audio via yt-dlp, transcribe locally with
#     faster-whisper. Slower (~1-2x realtime CPU), no API key, ignores
#     captions-disabled videos. First run downloads the model.
# TRANSCRIPT_METHOD=youtube_captions
# WHISPER_MODEL_SIZE=small        # tiny | base | small | medium | large-v3
# WHISPER_DEVICE=auto             # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=int8       # int8 (CPU) | float16 (GPU) | auto

# Workarounds for YouTube IP bans on the transcript phase. Use one or both:
#   - YT_TRANSCRIPT_COOKIES: path to a Netscape-format cookies file exported
#     from a browser where you're logged into YouTube. Export with the
#     "cookies.txt" extension or `yt-dlp --cookies-from-browser chrome
#     --cookies cookies.txt`. Authenticated requests are throttled more
#     gently than anonymous ones.
#   - YT_TRANSCRIPT_PROXY: generic HTTP/SOCKS proxy URL applied to all
#     transcript fetches, e.g. http://user:pass@proxy:8080 or
#     socks5://host:1080. A residential proxy is the most reliable fix
#     for a hard IP ban.
# YT_TRANSCRIPT_COOKIES=
# YT_TRANSCRIPT_PROXY=
