DATABASE_URL=postgres://poke:poke@localhost:5432/poke_investor

# Required only for the Python pipeline's `insights` phase. The Next.js app
# does not read this — leave blank if you only run discover/transcripts.
OPENAI_API_KEY=

# Point at a local OpenAI-compatible server (Ollama, LM Studio, llama.cpp).
# Leave unset to use api.openai.com. When set to a non-OpenAI URL, the
# pipeline auto-switches to `json_object` mode since strict structured
# outputs are an OpenAI-only feature. See pipeline/README.md for a
# step-by-step Ollama setup.
# OPENAI_BASE_URL=http://localhost:11434/v1
# PIPE_LLM_JSON_MODE=1   # force JSON mode regardless of base URL

# Per-environment LLM overrides — take precedence over whatever the active
# row in the `prompts` table has. Lets you keep the same prompt across dev
# and prod and just flip the model/temperature via env.
#   LLM_MODEL=qwen2.5:7b      # any non-empty value → overrides prompt.model
#   LLM_TEMPERATURE=0.1       # numeric → overrides prompt.temperature
#   LLM_TEMPERATURE=null      # literal "null" → omit temperature entirely
#                             # (needed for OpenAI o-series models)
#   LLM_TIMEOUT_SEC=1800      # per-request timeout. Default 1800 (30 min).
#                             # Local models on CPU can need this; the
#                             # OpenAI SDK's 600s default trips on long
#                             # transcripts through qwen2.5:14b.
# LLM_MODEL=
# LLM_TEMPERATURE=
# LLM_TIMEOUT_SEC=

# Token budget for the LLM call. The pipeline clips transcripts so the
# rendered prompt + reserved output fit within LLM_CONTEXT_TOKENS — this
# avoids the runner-side prompt truncation that breaks structured outputs
# (notably Ollama's `keep=4` truncation which drops the system prompt).
#
# Set LLM_CONTEXT_TOKENS to the *actual* context window of your server.
# For Ollama, that's the value of OLLAMA_CONTEXT_LENGTH you started it
# with (default 32768 for qwen2.5). For api.openai.com, use the model's
# native context.
#
# When a transcript doesn't fit, it's head+tail clipped: HEAD_RATIO of the
# budget from the *start* of the video, the remainder from the *end*. The
# middle is dropped with a `[... transcript clipped ...]` marker so the
# model knows. Pokémon investment videos usually front-load product picks
# and end with summaries, so 0.6 (60% head / 40% tail) preserves both.
#
# LLM_MIN_TRANSCRIPT_TOKENS is the floor — if context minus overhead minus
# output leaves less than this for the transcript, the video is skipped as
# errored rather than producing a near-empty prompt.
# LLM_CONTEXT_TOKENS=32768
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_TRANSCRIPT_HEAD_RATIO=0.6
# LLM_MIN_TRANSCRIPT_TOKENS=500

# Optional pipeline tunables (see pipeline/README.md for full list).
# PIPE_DISCOVER_MAX=50
# PIPE_INSIGHTS_BATCH=25
# PIPE_HTTP_TIMEOUT_SEC=30

# Which engine fetches transcripts:
#   - youtube_captions (default): scrape YouTube's timedtext endpoint. Fast,
#     free, brittle when YouTube IP-blocks you.
#   - whisper: download audio via yt-dlp, transcribe locally with
#     faster-whisper. Slower (~1-2x realtime CPU), no API key, ignores
#     captions-disabled videos. First run downloads the model.
# TRANSCRIPT_METHOD=youtube_captions
# WHISPER_MODEL_SIZE=small        # tiny | base | small | medium | large-v3
# WHISPER_DEVICE=auto             # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=int8       # int8 (CPU) | float16 (GPU) | auto

# Workarounds for YouTube IP bans on the transcript phase. Use one or both:
#   - YT_TRANSCRIPT_COOKIES: path to a Netscape-format cookies file exported
#     from a browser where you're logged into YouTube. Export with the
#     "cookies.txt" extension or `yt-dlp --cookies-from-browser chrome
#     --cookies cookies.txt`. Authenticated requests are throttled more
#     gently than anonymous ones.
#   - YT_TRANSCRIPT_PROXY: generic HTTP/SOCKS proxy URL applied to all
#     transcript fetches, e.g. http://user:pass@proxy:8080 or
#     socks5://host:1080. A residential proxy is the most reliable fix
#     for a hard IP ban.
# YT_TRANSCRIPT_COOKIES=
# YT_TRANSCRIPT_PROXY=

# Webhook for insight-mention alerts. When the pipeline extracts an insight
# whose mention links to an item you already hold (any prior buy), it POSTs
# a formatted message here. Compatible with Slack incoming webhooks, Discord
# webhooks, and generic JSON endpoints (body includes both `text` and
# `content` keys). Leave unset to disable alert delivery.
# ALERT_WEBHOOK_URL=

# Screenshot import (Import page). Needs a model that can read images; the
# chat model above usually can't. Leave unset to keep the feature off.
#   VISION_MODEL=gpt-4o-mini        # or a local vision model, e.g. via Ollama
#   VISION_BASE_URL=                # defaults to OPENAI_BASE_URL, else OpenAI
#   VISION_API_KEY=                 # defaults to OPENAI_API_KEY
# Screenshots are sent to that server to be read and are not stored. With a
# local server, nothing leaves your computer.
# After setting VISION_MODEL, `npm run check:vision` tests the model on made-up
# screenshots (none of your data) and says whether it can be trusted to import.
# VISION_MODEL=
# VISION_BASE_URL=
# VISION_API_KEY=

# Login. Leave unset and the app is open to anyone who can reach it, which is
# fine on your own computer. Set a password and every page, API call and action
# needs a signed-in session (one password, no accounts; a session lasts 30 days).
#   APP_PASSWORD=             # at least 8 characters. Too short = the app stays
#                             # LOCKED and the login page says why (it never
#                             # falls back to open). Use a long, unique one.
#   APP_SESSION_SECRET=       # optional, at least 16 random characters. Signs the
#                             # session cookie. Without it the signing key is
#                             # stretched from the password. With it, changing
#                             # the password does not sign everyone out; change
#                             # the secret to do that.
# Wrong passwords are slowed down and limited (5 per address per 15 minutes).
# Serve the app over HTTPS if it is reachable from outside: the password and
# the session cookie cross the network. Changing APP_PASSWORD (or the secret)
# ends every session; "Sign out" only forgets this browser.
# APP_PASSWORD=
# APP_SESSION_SECRET=

# Names the app answers to while it has NO login. Without a password the app
# trusts whoever can reach it, and a web page you visit could otherwise point its
# own domain at your computer (DNS rebinding) and read everything. So with the
# login off, it answers only on this computer ("localhost", 127.0.0.1), your own
# network (192.168.x.x, 10.x.x.x, "mac-mini", "nas.local", ...) and any names
# listed here, comma-separated. Not used once APP_PASSWORD is set.
# APP_ALLOWED_HOSTS=pokes.example.com

# eBay price estimates (the "Update prices" buttons). Needs an eBay developer
# keyset from developer.ebay.com: the App ID is EBAY_APP_ID, the Cert ID is
# EBAY_CERT_ID. It uses eBay's Browse API, which shows what sellers are ASKING,
# not what items sold for, so treat the result as approximate resale value.
# Without the keys those buttons say the credentials are missing.
# EBAY_APP_ID=
# EBAY_CERT_ID=
# EBAY_MARKETPLACE_ID=EBAY_US      # the default; e.g. EBAY_GB or EBAY_DE for other markets

# Used only by `npm run smoke` (set in your shell, not needed by the app):
#   BASE_URL=http://localhost:3000   where the running app is
#   SMOKE_PASSWORD=                  your APP_PASSWORD, if you turned the login on

# Scheduled price refresh. With CRON_TOKEN set, a scheduler can call the app to
# refresh market prices for what you hold (what "Update all prices" does).
# Without it that endpoint does not exist. Needs the eBay keys above.
#   CRON_TOKEN=               # at least 32 random characters: openssl rand -hex 32
# The pipeline (pipeline/.env or its secret) needs the SAME token and the address
# of the app, as the pipeline sees it:
#   APP_URL=http://localhost:3000
#   CRON_TOKEN=               # the same value
# With no login on the app, also list the scheduler's host name in
# APP_ALLOWED_HOSTS (see above), e.g. poke-investor.default.svc.cluster.local
# CRON_TOKEN=
# APP_URL=

# Point eBay calls somewhere else: eBay's sandbox (https://api.sandbox.ebay.com,
# with sandbox keys) or a local stand-in for testing. Default: https://api.ebay.com
# EBAY_API_BASE=
